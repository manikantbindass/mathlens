{
  "name": "mathlens-desktop",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Experimental MathLens online desktop client",
  "author": "manikantbindass",
  "main": "main.cjs",
  "scripts": {"start": "electron .", "package:win": "electron-builder --win nsis --publish never", "package:linux": "electron-builder --linux AppImage --publish never"},
  "devDependencies": {"electron": "45.0.0", "electron-builder": "26.18.0"},
  "build": {
    "appId": "dev.mathlens.desktop",
    "productName": "MathLens",
    "copyright": "MathLens contributors. Project license not yet selected.",
    "files": ["main.cjs", "navigation.cjs", "offline.html", "assets/**", "package.json"],
    "directories": {"output": "dist"},
    "win": {"icon": "assets/icon.ico", "signAndEditExecutable": false, "artifactName": "MathLens-${version}-windows-x64-unsigned.${ext}"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "runAfterFinish": false},
    "linux": {"icon": "assets/icon.png", "category": "Education", "executableName": "mathlens", "artifactName": "MathLens-${version}-linux-x86_64.${ext}"}
  }
}
